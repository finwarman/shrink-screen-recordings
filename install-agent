#!/bin/bash
# Install (or remove) a LaunchAgent that converts each new recording as it lands.
set -euo pipefail

readonly LABEL="com.finwarman.shrink-screen-recordings"
readonly PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT="$SCRIPT_DIR/shrink-screen-recordings"

if [ "${1:-}" = "--uninstall" ]; then
  launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
  echo "removed $LABEL"
  exit 0
fi

# The watched folder has to match the one the script reads, config included.
WATCH_DIR="$HOME/Documents/Screen Recordings"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/shrink-screen-recordings.conf"
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && SRC_DIR="" && source "$CONFIG" && [ -n "$SRC_DIR" ] && WATCH_DIR="$SRC_DIR"

[ -d "$WATCH_DIR" ] || { echo "no such folder: $WATCH_DIR" >&2; exit 1; }

# ~/Documents, ~/Desktop and ~/Downloads are TCC-protected. A launchd agent
# gets no prompt and no error there — directory reads just come back empty, so
# the agent runs forever converting nothing. Refuse rather than install that.
case "$WATCH_DIR/" in
  "$HOME/Documents/"*|"$HOME/Desktop/"*|"$HOME/Downloads/"*)
    cat >&2 <<WARN
$WATCH_DIR is in a folder macOS protects (Documents, Desktop, Downloads).

A LaunchAgent cannot read those. It is denied silently — no prompt, no error,
directory listings just come back empty — so the agent would run and convert
nothing. Running the command by hand from your terminal still works, because
your terminal has been granted access.

Either:
  1. Keep the recordings somewhere unprotected, e.g. ~/Movies/Screen Recordings,
     point QuickTime at it, and set SRC_DIR in
     ${XDG_CONFIG_HOME:-\$HOME/.config}/shrink-screen-recordings.conf
  2. Or grant Full Disk Access to /bin/bash in System Settings > Privacy &
     Security. This is broad and not recommended.

Re-run with --force to install anyway.
WARN
    [ "${1:-}" = "--force" ] || exit 1
    ;;
esac

mkdir -p "$HOME/Library/LaunchAgents"
cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$SCRIPT</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>$WATCH_DIR</string>
  </array>
  <!-- The watch fires when a recording is created, which is the run that waits
       it out. This is the net for events that happen while logged out or
       asleep; with nothing to do the script exits immediately. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>$HOME/Library/Logs/shrink-screen-recordings.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/shrink-screen-recordings.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
PLIST_EOF

plutil -lint "$PLIST" >/dev/null
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load "$PLIST"
echo "installed $LABEL"
echo "watching: $WATCH_DIR"
echo "log:      $HOME/Library/Logs/shrink-screen-recordings.log"
